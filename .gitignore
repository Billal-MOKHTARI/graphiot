# NOTE: git only treats '#' as a comment at the START of a line — never inline.

# Python environments (rebuilt by start.sh)
.venv/
.venv-b3/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# Pinned Python/Node toolchains fetched by start.sh
.tools/

# Build artifacts / caches
build/

# STruC++ toolchain: the binary and the npm tarball are downloaded by start.sh.
# Ignore everything under third_party/strucpp/ EXCEPT the pinned checksum it verifies.
third_party/strucpp/*
!third_party/strucpp/*.sha256

# Public baseline code (B3 E-GraphSAGE, B4 AIRGuard) is cloned on demand and has its own .git.
third_party/egraphsage/
third_party/airguard/

# Node dependencies (regenerated by `npm install` in start.sh)
node_modules/
plc/tools/node_modules/
gui/node_modules/
gui/dist/

# Experiment outputs (large; archived separately, not in git)
runs/
*.parquet

# Secrets — never commit
.env
*.key

# Editor / OS
.DS_Store
*.swp
