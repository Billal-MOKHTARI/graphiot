# Copy to .env and fill in. .env is git-ignored and never written to YAML, logs or exports.
# Local Ollama needs NO keys. Keys are only needed if you select a Gemini/Claude agent.
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# Optional: point agents at a remote Ollama (e.g. the Cnam GPU server)
# OLLAMA_BASE_URL=http://127.0.0.1:11434
