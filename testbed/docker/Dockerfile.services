# One image for every Python service of the testbed (field I/O, gateway, HMI,
# EWS, capture). Source code is bind-mounted read-only at runtime, so code
# changes never require a rebuild; only requirements/services.txt does.
FROM python:3.12.13-slim-bookworm@sha256:4766d8b510c428e595d74b9cc5bbb2fae8e26316fffb4adc89908d79aacd58a2
RUN apt-get update \
 && apt-get install -y --no-install-recommends tcpdump iproute2 \
 && rm -rf /var/lib/apt/lists/*
COPY requirements/services.txt /tmp/services.txt
RUN pip install --no-cache-dir -r /tmp/services.txt && rm /tmp/services.txt
ENV PYTHONPATH=/app/src PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
